# Copy this file to deploy/.env before the first deployment.
# Every secret below should be generated independently.

# PostgreSQL administrator password.
# Generate with: openssl rand -hex 32
POSTGRES_ADMIN_PASSWORD=replace_with_a_generated_secret

# PostgreSQL application-role password for atelier_app.
# Generate with: openssl rand -hex 32
POSTGRES_APP_PASSWORD=replace_with_a_generated_secret

# MongoDB root password used only for container administration and health checks.
# Generate with: openssl rand -hex 32
MONGO_ADMIN_PASSWORD=replace_with_a_generated_secret

# MongoDB application password for the least-privilege atelier_logs user.
# Generate with: openssl rand -hex 32
MONGO_APP_PASSWORD=replace_with_a_generated_secret

# Bearer token protecting the administrative API endpoint.
# Generate with: openssl rand -hex 32
ADMIN_API_TOKEN=replace_with_a_generated_secret

# Public application URL.
# The API uses this exact origin for CORS, and the Front Docker build compiles
# the same value as VITE_API_URL so browser requests target nginx on this origin.
# Open the application exactly at this URL. For a real deployment, use the
# public HTTPS origin, for example: https://atelier.example.org
FRONTEND_ORIGIN=http://127.0.0.1:8080

# Workshop exposed by the production Front build.
VITE_WORKSHOP_ID=2
